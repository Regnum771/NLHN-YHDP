# dev | test | production. `seed` and `reset-dev` run only when this says dev or test.
APP_ENV=dev
# 127.0.0.1, not localhost: on Windows with Docker Desktop, localhost tries ::1 first and a connect can stall for 30 s.
DATABASE_URL=postgresql://demo:demo@127.0.0.1:5433/yhdp_demo
DATABASE_URL_TEST=postgresql://demo:demo@127.0.0.1:5433/yhdp_demo_test
ANTHROPIC_API_KEY=
# 0 = always call the model; 1 = fall back to the replay cache when a call fails;
# prefer = serve the rehearsed reply when there is one (use this at the kickoff)
DEMO_REPLAY=0
